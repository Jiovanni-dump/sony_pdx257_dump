####################################
#
# system prop for sony qssi
#
# System props for telephony
ro.telephony.default_network=26,26
ro.config.ringtone2=air.ogg
# Platform limited sample rate range
ro.mediacodec.min_sample_rate=7350
ro.mediacodec.max_sample_rate=2822400
# Enable safe media volume
audio.safemedia.force=true
# Change media volume step
ro.config.media_vol_steps=30
# Set Mediavibration max volume step
ro.config.mv_volume_steps=3
# Change the number of maximum fast tracks
ro.audio.max_fast_tracks=16
# WLAN
# Set default Wi-Fi country code as "00". It can be overridden by customization.
ro.boot.wificountrycode=00
# Audio(RID003804)
ro.config.vc_call_vol_steps=8
ro.config.vc_call_vol_default=4
# Enable Color-Gamut
ro.sys.colorgamut.supported=true
persist.sony.colorgamut.mode=1
# Added system property for RID009076
persist.sony.automaster.mode=true
persist.sony.colorgamut.current.mode=1
persist.vendor.reduce_afterimage.mode=false
# Display(RID012364)
persist.sony.display.dynamic_tone_mapping.mode=true
# Display(RID015163)
persist.sony.display.recommended_settings=true
persist.sony.display.adaptive_color.mode=true
# X1 default setting
persist.service.xrfm.mode=1
# Application Framework
# To avoid watchdog timeout loop, reboot the system when watchdog timed out 'fatal_count' times
# in 'fatal_window_seconds' same as Pixel only for USERDEBUG variant
framework_watchdog.fatal_window.second=600
framework_watchdog.fatal_count=3
# Set host name for remote key provisioning server
remote_provisioning.hostname=remoteprovisioning.googleapis.com
# Audio(RID014419 Audio setting UI growth)
ro.vendor.audio.setting_ui_version=1
# Window of time when 4 crashes need to happen so that recovery is attempted
zygote.critical_window.minute=30
